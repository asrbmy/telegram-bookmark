{
  "manifest_version": 2,
  "name": "Telegram Bookmark",
  "version": "2.0.0",
  "description": "Save links, files, screenshots and videos to topic-based Telegram groups.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "quick-save": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save current page to Telegram"
    }
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "https://api.telegram.org/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_permissions": [
    "<all_urls>"
  ],
  "background": {
    "page": "background.html"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Save to Telegram",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": "script-src 'self'; object-src 'self'; base-uri 'none'",
  "browser_specific_settings": {
    "gecko": {
      "id": "telegram-bookmark@asrbmy.github.io",
      "strict_min_version": "109.0"
    }
  },
  "homepage_url": "https://github.com/asrbmy/telegram-bookmark",
  "developer": {
    "name": "asrbmy & linkwithiq",
    "url": "https://asrbmy.github.io"
  }
}